# Evolution API
AUTHENTICATION_API_KEY=
EVO_BASE_URL=
EVO_INSTANCE_NAME=

# Versão do WhatsApp Web usada pelo Baileys. Se ficar desatualizada, o QR code
# simplesmente NÃO é gerado: a instância entra em loop de reconexão e não
# registra erro nenhum. Consulte a atual em:
#   https://raw.githubusercontent.com/WhiskeySockets/Baileys/master/src/Defaults/baileys-version.json
CONFIG_SESSION_PHONE_VERSION=2.3000.1043857760

# Application database (PostGIS) — the `conectese-db` service in docker-compose.
# Note: port 5434, since 5433 is the Evolution API's own Postgres.
CONECTESE_DATABASE_URL=postgresql+asyncpg://conectese:conectese@localhost:5434/conectese
CONECTESE_POSTGRES_USER=conectese
CONECTESE_POSTGRES_PASSWORD=conectese
CONECTESE_POSTGRES_DB=conectese

# AI (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Routing / ETA (Google Routes API).
# Leave empty to fall back to the built-in Haversine estimate.
GOOGLE_MAPS_API_KEY=

# RUMO data source (Grande Recife) — defaults are fine
RUMO_BASE_URL=https://virtual.granderecife.pe.gov.br/rumo
RUMO_MAX_CONCURRENCY=4
